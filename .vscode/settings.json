{
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "package",
  "go.lintFlags": ["--fast"],
  "go.formatTool": "gofumpt",
  "go.useLanguageServer": true,
  "gopls": {
    "formatting.gofumpt": true
  },
  "go.testFlags": [
    "-benchmem",
    "-benchtime",
    "1s",
    "-args",
    "-dotenv-dir",
    "${workspaceFolder}"
  ],
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    {"directory": "/"}
  ]
}

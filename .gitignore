# Mac OS X files
.DS_Store

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.out
coverage.html
# WS-22: local coverage profiles (any extension) + report dirs.
coverage*
/coverage_html/
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
/playwright/.ms-playwright/

# Glide cache (legacy)
.glide/

# Go workspace files
go.work
go.work.sum

# Build output
/dist/
/build/output/

# Dependency directories (uncomment to vendor)
# vendor/

# IDE / editor
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Frontend (web/, website/, docs-site/)
**/node_modules/
**/dist/
**/.vite/
**/.turbo/
**/.next/
**/.docusaurus/
**/build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files (keep .env.example)
.env
.env.local
.env.*.local
!.env/

# Secrets
*.pem
*.key
/secrets/

# Logs (especially the WS runner logs)
logs/


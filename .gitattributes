# Default: treat as text, preserve whatever line endings are in the file.
* text=auto

# PowerShell scripts MUST be CRLF on disk for Windows PowerShell 5.x to parse
# them correctly (LF-only causes "Unexpected token" errors in some contexts).
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.psd1    text eol=crlf

# Go, YAML, JSON, MD, JS-family: keep LF (Unix convention; works everywhere).
# The JS/CSS/HTML rules also satisfy Prettier's `endOfLine: "lf"` config in
# web/.prettierrc.json and website/.prettierrc.json — without them, Windows
# developers with core.autocrlf=true see phantom "prettier --check" failures.
*.go      text eol=lf
*.sql     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.tsx     text eol=lf
*.ts      text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.css     text eol=lf
*.html    text eol=lf

# Binaries.
*.png     binary
*.jpg     binary
*.pdf     binary
*.ico     binary
*.woff    binary
*.woff2   binary

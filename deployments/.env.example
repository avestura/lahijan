# Lahijan — example environment for docker-compose.dev.yml.
#
# Copy this file to deployments/.env (or repository-root .env) and edit.
# Never commit the real .env file. Every value below is a dev-only default
# suitable for `make dev-up`; override for any non-local environment.

# --- Postgres superuser (used only by the container's entrypoint) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_SUPERUSER_DB=postgres
POSTGRES_PORT=5432

# --- Lahijan application database (owned by this WS; the real schema) ---
LAHIJAN_DATABASE_HOST=localhost
LAHIJAN_DATABASE_PORT=5432
LAHIJAN_DATABASE_NAME=lahijan
LAHIJAN_DATABASE_USER=lahijan
LAHIJAN_DATABASE_PASSWORD=lahijan
LAHIJAN_DATABASE_SSLMODE=disable
LAHIJAN_DATABASE_MAX_CONNS=20
LAHIJAN_DATABASE_MIN_CONNS=2
LAHIJAN_DATABASE_MAX_CONN_IDLE_SECONDS=300
LAHIJAN_DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- PowerDNS database (created now; schema lands in WS-12) ---
PDNS_DATABASE_NAME=pdns
PDNS_DATABASE_USER=pdns
PDNS_DATABASE_PASSWORD=pdns

# --- PowerDNS API (WS-12). Lahijan talks to PDNS over HTTP. ---
# The API key PDNS expects in the X-API-Key header. In dev the
# docker-compose stack seeds this; in any non-dev environment set it to a
# high-entropy secret before `make dev-up`.
PDNS_API_KEY=lahijan-dev-pdns-key
# Port the PDNS HTTP API is published on the host (matches
# conf.providers.powerdns.baseURL when Lahijan runs on the host).
PDNS_API_PORT=8081
# Authoritative DNS port published on the host for `dig @localhost` during
# dev. 5300 to avoid clashing with any host resolver on :53.
PDNS_DNS_PORT=5300

# --- SeaweedFS filer database (created now; schema lands in WS-13) ---
SEAWEED_DATABASE_NAME=seaweed
SEAWEED_DATABASE_USER=seaweed
SEAWEED_DATABASE_PASSWORD=seaweed

# --- Incus daemon (WS-11). Incus runs on the host; Lahijan connects over the
# --- Unix socket. The incus-client sidecar container (optional; profile-gated)
# --- uses this path for its bind-mount. Leave at the default for snap installs.
INCUS_SOCKET_PATH=/var/lib/incus/unix.socket

# --- PowerDNS driver (WS-12). When LAHIJAN_PROVIDERS_POWERDNS_ENABLED=true,
# --- Lahijan builds the PDNS driver at startup and the DNS module (WS-15)
# --- uses it. LAHIJAN_PROVIDERS_POWERDNS_API_KEY must match PDNS_API_KEY
# --- above (the value Lahijan sends to PDNS).
LAHIJAN_PROVIDERS_POWERDNS_ENABLED=false
LAHIJAN_PROVIDERS_POWERDNS_BASE_URL=http://localhost:8081
LAHIJAN_PROVIDERS_POWERDNS_API_KEY=

# --- SeaweedFS driver (WS-13). When LAHIJAN_PROVIDERS_SEAWEEDFS_ENABLED=true,
# --- Lahijan builds the SeaweedFS driver at startup and the storage module
# --- (WS-16) uses it. The admin access key + secret MUST match the values
# --- the compose stack hands to the `weed s3` container (see SEAWEEDFS_S3_*
# --- below). In dev the compose stack seeds these; in any non-dev
# --- environment set them to high-entropy secrets before `make dev-up`.
LAHIJAN_PROVIDERS_SEAWEEDFS_ENABLED=false
LAHIJAN_PROVIDERS_SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
LAHIJAN_PROVIDERS_SEAWEEDFS_FILER_URL=http://localhost:8888
LAHIJAN_PROVIDERS_SEAWEEDFS_ADMIN_ACCESS_KEY=
LAHIJAN_PROVIDERS_SEAWEEDFS_ADMIN_SECRET_KEY=

# --- SeaweedFS container (WS-13). These seed the admin credentials the
# --- `weed s3` container is configured with; the Lahijan driver's
# --- LAHIJAN_PROVIDERS_SEAWEEDFS_ADMIN_ACCESS_KEY must match
# --- SEAWEEDFS_S3_ACCESS_KEY (and same for secret).
SEAWEEDFS_S3_ACCESS_KEY=lahijan_dev_admin_key
SEAWEEDFS_S3_SECRET_KEY=lahijan_dev_admin_secret
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_MINI_DATA_DIR=./data/seaweedfs

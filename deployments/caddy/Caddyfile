# Lahijan production Caddyfile (WS-23).
#
# Caddy is the canonical TLS-terminating reverse proxy for Lahijan. It was
# picked over Traefik in ADR-0030 for the prod topology because of its
# dead-simple config (one file, no labels) and its built-in Let's Encrypt
# integration (no external ACME helper container).
#
# The site address is templated from $LAHIJAN_PUBLIC_HOST so the operator
# only sets one env var in .env.prod. The email for ACME is read from
# $ACME_EMAIL (optional — Caddy falls back to a stable per-deploy value).
#
# TLS policy:
#   - Caddy issues a cert automatically on first boot via Let's Encrypt.
#   - HTTP/3 (QUIC) is enabled by default; the prod compose publishes
#     443/udp so QUIC clients see lower latency.
#   - The internal services (Lahijan app, Grafana, Jaeger) are NOT exposed
#     directly; only Caddy listens on public ports.
#
# Routing:
#   /                          → Lahijan dashboard (single-page app)
#   /api/*                     → Lahijan REST API
#   /admin/jobs/ui/*           → River admin UI (admin-only)
#   /grafana/*                 → Grafana (operator-only; gated below)
#   /jaeger/*                  → Jaeger UI (operator-only)
#   /observability/grafana/*   → alias for /grafana when the operator wants
#                                 a less guessable path (set
#                                 LAHIJAN_OBSERVABILITY_PUBLIC=false to
#                                 disable the public mount entirely).
#
# The operator can layer additional routes (e.g. S3 path-style on :443)
# via a Caddyfile snippet in deployments/caddy/Caddyfile.local — Caddy
# imports it via the `include_local` snippet below when the file exists.

# Global options. The email is read from env so the operator can get
# Let's Encrypt expiry notifications.
{
	email {$ACME_EMAIL:}
}

# Primary site: the public dashboard origin. Caddy issues a cert for this
# hostname automatically.
# shellcheck disable=SC2154
{$LAHIJAN_PUBLIC_HOST} {
	# Encode responses (gzip + zstd) so the SPA bundle ships smaller.
	encode zstd gzip

	# Trusted proxies: anything on the compose backend network. Caddy
	# passes X-Forwarded-* through to Lahijan; Lahijan trusts the proxy
	# because it never serves the public directly (only via Caddy).
	trusted_proxies static private_ranges

	# The dashboard SPA + REST API + admin endpoints all live on the Lahijan
	# app. Caddy reverse-proxies everything that does not match a more
	# specific route below.
	reverse_proxy lahijan:8080 {
		# Flush immediately so SSE / chunked responses (audit log stream,
		# River admin UI websocket) work without buffering.
		flush_interval -1
		# Forward the original Host so Lahijan's CORS + redirect logic
		# sees the public hostname.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Operator-only routes — gated by basic auth. Set
	# LAHIJAN_OBSERVABILITY_PUBLIC=false in .env.prod to suppress these
	# routes entirely (the operator would then port-forward over SSH).
	@grafana path /grafana/* /grafana
	handle @grafana {
		basic_auth {
			# Default admin credentials — OVERWRITE via .env.prod by
			# running `caddy hash-password` and pasting the bcrypt hash
			# here. The operator-only route is the only protection on
			# Grafana's built-in admin login; do not leave the default.
			{$GRAFANA_BASIC_AUTH_USER:-admin} {$GRAFANA_BASIC_AUTH_HASH:-JDJhJDE0JEhCS2JRdTlGRjJ4ck9OWWNEMOjVXe2tJSxF9/d3UzS2lWUHl4OE9LZm9tZVJ2UXouTjg4NTQ4}
		}
		strip_prefix /grafana
		reverse_proxy grafana:3000
	}

	@jaeger path /jaeger/*
	handle @jaeger {
		basic_auth {
			{$JAEGER_BASIC_AUTH_USER:-admin} {$JAEGER_BASIC_AUTH_HASH:-JDJhJDE0JEhCS2JRdTlGRjJ4ck9OWWNEMOjVXe2tJSxF9/d3UzS2lWUHl4OE9LZm9tZVJ2UXouTjg4NTQ4}
		}
		strip_prefix /jaeger
		reverse_proxy jaeger:16686
	}
}

# Optional S3 endpoint on its own hostname (e.g. s3.example.com). Set
# LAHIJAN_S3_PUBLIC_HOST in .env.prod to enable virtual-host-style S3
# addressing; when empty the operator uses path-style on the dashboard host.
{$LAHIJAN_S3_PUBLIC_HOST:} {
	reverse_proxy seaweed-s3:8333 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Local-override include so operators can layer extra site blocks (e.g. for
# MinIO console, Prometheus, custom dashboards) without editing this file.
# The import fails silently when the file is absent (Caddy treats it as a
# snippet include). Create deployments/caddy/Caddyfile.local to use.
include_local:
try_include /etc/caddy/Caddyfile.local
